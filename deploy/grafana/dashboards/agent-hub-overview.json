{
  "uid": "agent-hub-overview",
  "title": "Agent Hub 概览",
  "tags": ["agent-hub"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP RPS",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum(rate(agent_hub_http_requests_total[5m])) by (route)"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP P95 延迟",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(agent_hub_http_request_duration_seconds_bucket[5m])) by (le, route))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SSE 活跃连接",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "agent_hub_sse_connections_active"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Chat P95 时长 / 首 token P95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(agent_hub_chat_run_duration_seconds_bucket[5m])) by (le))"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(agent_hub_chat_first_token_seconds_bucket[5m])) by (le, model))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM token / 工具错误",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_hub_llm_tokens_total[5m])) by (kind)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(agent_hub_tool_invocations_total{status=\"error\"}[5m])) by (tool)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "A2A / 知识库检索 P95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(agent_hub_a2a_task_duration_seconds_bucket[5m])) by (le, status))"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(agent_hub_knowledge_search_duration_seconds_bucket[5m])) by (le, status))"
        }
      ]
    }
  ]
}
