# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，严禁把真实密钥提交到仓库。

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
APP_NAME=agent-hub
# dev / test / prod
ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# 前端关于页展示的构建标识，可填日期或 commit
APP_BUILD=dev
# 前端开发服务器地址；生产环境改成实际域名，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# PostgreSQL（业务表 + 向量检索 + LangGraph checkpoint 统一存储）
# 使用本机已有的 PostgreSQL，按实际的用户名/密码/端口/库名修改。
# 下面的 5432 与 postgres 账号只是示例，不是项目托管的环境。
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_hub
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# LangGraph PostgresSaver 使用的连接串（不填则从 DATABASE_URL 推导）
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_hub
CHECKPOINT_SCHEMA=langgraph
# postgres：生产/联调使用 PostgresSaver；memory：无数据库的测试环境
CHECKPOINT_BACKEND=postgres

# ---------------------------------------------------------------------------
# 对话模型（DeepSeek 官方接口为 OpenAI 兼容协议，可替换为任意兼容端点）
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 逗号分隔的模型白名单；为空时只允许 LLM_MODEL
LLM_MODELS=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
# 推理等级开关：默认 false 时 /system/info.reasoning_efforts=[]，前端隐藏选择器；
# 改成 true 后返回 low/medium/high 三个等级（是否真正影响模型取决于所选模型）。
# 注意：运行中的实例改完需要重启后端才会生效。
LLM_REASONING_EFFORT_SUPPORTED=false
# 没有 LLM_API_KEY 时，开发/测试环境使用假流式模型；生产禁止
FAKE_LLM_DELAY_MS=15

# ---------------------------------------------------------------------------
# Embedding（OpenAI 兼容接口，可切硅基流动 / 阿里百炼 / 本地 vLLM 等）
# ---------------------------------------------------------------------------
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度必须与 embedding 模型一致，改动后需要重建 knowledge_chunks 向量列
EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# 向量检索
# ---------------------------------------------------------------------------
VECTOR_TOP_K=6
VECTOR_SCORE_THRESHOLD=0.30

# ---------------------------------------------------------------------------
# A2A
# ---------------------------------------------------------------------------
# 本服务对外暴露的 A2A Agent 地址（用于生成 Agent Card 中的 url 字段）
A2A_PUBLIC_URL=http://localhost:8000
# M2 已实现 A2A 出站（远程 Agent 注册/委派）；M3 入站 Server 接入后再改为 true
A2A_ENABLED=false
# 本服务 A2A 端点挂载路径（JSON-RPC 与 Agent Card）
A2A_AGENT_PATH=/a2a
# 调用远程智能体的 HTTP 超时（秒）；message/send 非终态时按此超时轮询 tasks/get
A2A_CLIENT_TIMEOUT_SECONDS=60
# 允许访问的内网/回环 Agent 主机白名单，逗号分隔（主机名/IP/CIDR）；为空表示仅允许公网地址
A2A_ALLOWED_HOSTS=
# 是否允许注册回环地址（127.0.0.1/localhost）的远程 Agent。
# 留空 = 跟随环境：dev/test 允许（本地假 Agent 联调），prod 拒绝。
A2A_ALLOW_LOOPBACK=
# Agent Card 拉取超时（秒）
A2A_CARD_TIMEOUT_SECONDS=10
# Agent Card 技能数量上限与单技能描述长度上限
A2A_MAX_SKILLS=50
A2A_SKILL_DESCRIPTION_MAX_CHARS=2000
# input_required/auth_required 等待用户动作的默认超时（秒），到期任务自动取消
A2A_INPUT_TIMEOUT_SECONDS=1800
# 远程响应体上限（字节），超出截断或拒绝
A2A_MAX_RESPONSE_BYTES=1048576

# ---------------------------------------------------------------------------
# 认证（JWT_SECRET 必填；生成方式：openssl rand -hex 32）
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# 运行与限流
# ---------------------------------------------------------------------------
# 单进程内存限流；多实例时每个实例各自计数（M6 换 Redis）
RATE_LIMIT_ENABLED=true
# 注册/登录按 IP 限流。前端联调反复注册时，可临时放宽注册限额，
# 或直接用 scripts/seed_dev_account.py 复用固定账号（推荐）。
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
# HITL 等待上限（秒）；审批超时（秒）
HITL_STREAM_TIMEOUT_SECONDS=900
APPROVAL_TIMEOUT_SECONDS=1800
# 消息/指令/附件的上限
MESSAGE_MAX_CHARS=8000
INSTRUCTION_MAX_CHARS=4000
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENTS_PER_MESSAGE=5
SKILLS_PER_MESSAGE=3
MCP_SERVERS_PER_MESSAGE=5
MCP_TOOLS_PER_MESSAGE=10
DATA_DIR=data
ATTACHMENT_DIR=data/attachments

# ---------------------------------------------------------------------------
# 个人能力层（M1.5）：指令 / 记忆 / 技能 / MCP / 附件
# ---------------------------------------------------------------------------
# 能力总开关；关闭后相关接口返回 403 capability_disabled
INSTRUCTIONS_ENABLED=true
MEMORIES_ENABLED=true
SKILLS_ENABLED=true
MCP_ENABLED=true
ATTACHMENTS_ENABLED=true
APPROVALS_ENABLED=true

# 用户自建 MCP 只允许远程 URL；stdio 默认关闭（打开属于运维显式决策，无隔离保证）
MCP_USER_STDIO_ENABLED=false
# 允许访问的内网/回环 MCP 主机白名单，逗号分隔；为空时仅允许公网地址（测试注入用）
MCP_ALLOWED_HOSTS=
# 系统 stdio MCP 允许的命令白名单，逗号分隔（按可执行文件 basename）
MCP_STDIO_ALLOWED_COMMANDS=
MCP_CLIENT_TIMEOUT_SECONDS=30
MCP_MAX_SERVERS_PER_USER=20
MCP_MAX_TOOLS_PER_SERVER=50
MCP_MAX_AUTO_TOOLS=60
MCP_MAX_RESPONSE_BYTES=262144
MCP_TOOL_CACHE_TTL_SECONDS=86400
MAX_TOOL_ROUNDS=8
# MCP 敏感请求头 AES-GCM 加密密钥（openssl rand -hex 32）；未配置时只允许 env: 引用
CAPABILITY_SECRET_KEY=

# 技能包导入限制
SKILL_MAX_UPLOAD_BYTES=5242880
SKILL_MAX_FILES=50
SKILL_MAX_FILE_BYTES=1048576
SKILL_MAX_SKILL_MD_BYTES=204800
SKILL_MAX_BODY_TOKENS=8000
SKILL_FILE_READ_MAX_BYTES=32768
SKILL_CATALOG_MAX_ITEMS=100

# 长期记忆
MEMORY_TOP_K=5
MEMORY_MAX_TOKENS=1200
MEMORY_MAX_ITEM_CHARS=1000
MEMORY_MAX_TITLE_CHARS=200
MEMORY_PINNED_MAX=10
MEMORY_MAX_SAVES_PER_RUN=5

# 附件
# 逗号分隔的 MIME 类型白名单；单文件上限 ATTACHMENT_MAX_BYTES（见“运行与限流”区）
ATTACHMENT_ALLOWED_MIME_TYPES=text/plain,text/markdown,text/csv,text/html,application/json,application/pdf,application/zip,application/msword,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg,image/gif,image/webp,audio/mpeg,audio/wav,video/mp4,application/x-yaml,application/xml
# 文本类附件注入模型上下文的字符上限
ATTACHMENT_TEXT_MAX_CHARS=12000
ATTACHMENT_RETENTION_HOURS=720

# 静态提示词总预算（token）
PROMPT_BUDGET_TOKENS=16000
