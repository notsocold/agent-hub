# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 环境与本地数据（API key、数据库密码不进代码仓库）
.env
.env.*
!.env.example
*.db
*.sqlite3

# 向量索引的本地导出物（正式数据在 PostgreSQL 中）
vector_index/

# 测试与工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 日志
logs/
*.log

# IDE
.vscode/
.idea/


# 本地 uv 缓存与 Python 解释器（体积大，不进仓库）
.uv-cache/
.uv-python/
.pgdata*/
.tmp/
.run/
.dev/

# 本地附件存储
data/attachments/

# 测试用知识库原文存储（用例结束后由 conftest 清理，绝不入库）
data/test-knowledge/

# DSH workspace-session (managed by dsh-workspace-session)
.dsh/workspace-session.json
.dsh/sessions/**/session.lock
.dsh/sessions/**/*.tmp
.dsh/sessions/.backup/
.dsh/workspace-session.json

# SDD 计划工作区（scratch，git 忽略）
.superpowers/
